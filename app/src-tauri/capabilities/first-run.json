{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "first-run",
  "description": "Least privilege for the first-run surface",
  "windows": [
    "first-run"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-offhand-settings",
    "allow-offhand-set-hotkey",
